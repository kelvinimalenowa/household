<!doctype html>
<html>

<head>
    <title>Household | Edit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="container py-4">
    <h2>Edit listing</h2>
    <form action="/listings/<%= listing._id %>/edit" method="POST">
        <input class="form-control mb-2" type="text" name="address" value="<%= listing.address %>" required>
        <input class="form-control mb-2" type="number" name="rent" value="<%= listing.rent %>" min="0" required>
        <input class="form-control mb-2" type="number" name="bedrooms" value="<%= listing.bedrooms %>" min="0">
        <input class="form-control mb-2" type="text" name="link" value="<%= listing.link %>">
        <input class="form-control mb-2" type="text" name="notes" value="<%= listing.notes %>">
        <select class="form-select mb-3" name="status">
            <% ['Interested', 'Toured' , 'Applied' , 'Rejected' ].forEach(s=> { %> <option value="<%= s %>"
                    <%=listing.status===s ? 'selected' : '' %>><%= s %>
                </option>
                <% }) %>
        </select>
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-link" href="/listings">Cancel</a>
    </form>
</body>

</html>