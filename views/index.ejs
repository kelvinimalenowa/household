<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Household</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <nav class="navbar navbar-dark bg-primary">
        <div class="container">
            <span class="navbar-brand fw-bold">Household</span>
            <div class="d-flex gap-2">
                <a href="/login" class="btn btn-sm btn-outline-light">Log in</a>
                <a href="/signup" class="btn btn-sm btn-light">Sign up</a>
            </div>
        </div>
    </nav>

    <header class="hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-3">Keep every apartment you're considering in one place.</h1>
                    <p class="lead mb-4">Save listings, track where you are with each one, and never lose a link again.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/signup" class="btn btn-light btn-lg">Get started</a>
                        <a href="/login" class="btn btn-outline-light btn-lg">Log in</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="container py-5">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">🏠</div>
                        <h2 class="h5">Save every listing</h2>
                        <p class="text-secondary mb-0">Address, rent, bedrooms, notes, and the link back to the original post, all on one card.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">📋</div>
                        <h2 class="h5">Track your progress</h2>
                        <p class="text-secondary mb-0">Mark each place as interested, toured, applied, or rejected as your search moves along.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">🔍</div>
                        <h2 class="h5">Filter at a glance</h2>
                        <p class="text-secondary mb-0">Jump straight to the places you've toured or applied to without scrolling through everything.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="container text-center pb-4">
        <small>Household · Apartment hunting, organized.</small>
    </footer>

</body>

</html>