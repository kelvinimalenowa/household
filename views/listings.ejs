<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Household | Listings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar bg-primary navbar-dark">
        <div class="container">
            <span class="navbar-brand fw-bold">Household</span>
            <a href="/logout" class="btn btn-sm btn-outline-light">Log out</a>
        </div>
    </nav>

    <main class="container py-4">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Add a listing</h2>
                <form action="/listings" method="POST" class="row g-2">
                    <div class="col-12 col-md-6">
                        <input class="form-control" type="text" name="address" placeholder="Address" required>
                    </div>
                    <div class="col-6 col-md-3">
                        <input class="form-control" type="number" name="rent" placeholder="Rent" min="0" required>
                    </div>
                    <div class="col-6 col-md-3">
                        <input class="form-control" type="number" name="bedrooms" placeholder="Bedrooms" min="0">
                    </div>
                    <div class="col-12 col-md-6">
                        <input class="form-control" type="text" name="link" placeholder="Listing link (optional)">
                    </div>
                    <div class="col-12 col-md-6">
                        <input class="form-control" type="text" name="imageUrl" placeholder="Image URL (optional)">
                    </div>
                    <div class="col-12">
                        <input class="form-control" type="text" name="notes" placeholder="Notes (optional)">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Add listing</button>
                    </div>
                </form>
            </div>
        </div>

        <h2 class="h4 mb-3">Your listings</h2>

        <div class="mb-3 d-flex flex-wrap gap-2">
            <% ['all', 'Interested' , 'Toured' , 'Applied' , 'Rejected' ].forEach(s=> { %>
                <a href="/listings<%= s === 'all' ? '' : '?status=' + s %>"
                    class="btn btn-sm <%= activeStatus === s ? 'btn-primary' : 'btn-outline-primary' %>">
                    <%= s %>
                </a>
                <% }) %>
        </div>

        <% if (listings.length===0) { %>
            <p class="text-secondary">No listings here.</p>
            <% } %>

                <div class="row g-3">
                    <% listings.forEach(listing=> { %>
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card listing-card h-100 border-0 shadow-sm overflow-hidden">

                                <div class="listing-photo">
                                    <% if (listing.imageUrl) { %>
                                        <img src="<%= listing.imageUrl %>" alt="Photo for <%= listing.address %>">
                                        <% } %>
                                            <span class="badge status-<%= listing.status.toLowerCase() %>">
                                                <%= listing.status %>
                                            </span>
                                            <div class="listing-overlay">
                                                <h5 class="mb-0">
                                                    <%= listing.address %>
                                                </h5>
                                                <small>
                                                    $<%= listing.rent %>
                                                        <% if (listing.bedrooms !==undefined && listing.bedrooms
                                                            !==null) { %>
                                                            · <%= listing.bedrooms %> bed
                                                                <% } %>
                                                </small>
                                            </div>
                                </div>

                                <div class="card-body">
                                    <% if (listing.notes) { %>
                                        <p class="card-text">
                                            <%= listing.notes %>
                                        </p>
                                        <% } %>
                                            <% if (listing.imageCredit) { %>
                                                <small class="text-muted">
                                                    Photo by <a href="<%= listing.imageCreditUrl %>">
                                                        <%= listing.imageCredit %>
                                                    </a>
                                                    on <a
                                                        href="https://unsplash.com/?utm_source=household&utm_medium=referral">Unsplash</a>
                                                </small>
                                                <% } %>
                                </div>

                                <div class="card-footer bg-white d-flex gap-2">
                                    <% if (listing.link) { %>
                                        <a href="<%= listing.link %>" target="_blank" rel="noopener"
                                            class="btn btn-sm btn-primary">View listing</a>
                                        <% } %>
                                            <a href="/listings/<%= listing._id %>/edit"
                                                class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form action="/listings/<%= listing._id %>/delete" method="POST"
                                                class="ms-auto">
                                                <button class="btn btn-sm btn-outline-danger"
                                                    type="submit">Delete</button>
                                            </form>
                                </div>

                            </div>
                        </div>
                        <% }) %>
                </div>

    </main>
</body>

</html>