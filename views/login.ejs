<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Household | Log in</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/registrations/registration-9/assets/css/registration-9.css">
</head>

<body>
    <section class="bg-primary min-vh-100 d-flex align-items-center py-3 py-md-5">
        <div class="container">
            <div class="row gy-4 align-items-center">

                <div class="col-12 col-md-6 col-xl-7">
                    <div class="d-flex justify-content-center text-bg-primary">
                        <div class="col-12 col-xl-9">
                            <h1 class="display-5 fw-bold mb-3">Household</h1>
                            <hr class="border-primary-subtle mb-4">
                            <h2 class="h1 mb-4">Keep every apartment you're considering in one place.</h2>
                            <p class="lead mb-0">Save listings, track where you are with each one, and never lose a link again.</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-5">
                    <div class="card border-0 rounded-4">
                        <div class="card-body p-3 p-md-4 p-xl-5">

                            <div class="mb-4">
                                <h2 class="h3">Welcome back</h2>
                                <h3 class="fs-6 fw-normal text-secondary m-0">Log in to see your listings</h3>
                            </div>

                            <% if (typeof message !=='undefined' && message.length> 0) { %>
                                <div class="alert alert-danger" role="alert">
                                    <%= message %>
                                </div>
                                <% } %>

                                    <form action="/login" method="POST">
                                        <div class="form-floating mb-3">
                                            <input type="email" class="form-control" name="email" id="email"
                                                placeholder="name@example.com" autocomplete="email" required>
                                            <label for="email">Email</label>
                                        </div>
                                        <div class="form-floating mb-4">
                                            <input type="password" class="form-control" name="password" id="password"
                                                placeholder="Password" autocomplete="current-password" required>
                                            <label for="password">Password</label>
                                        </div>
                                        <div class="d-grid">
                                            <button class="btn btn-primary btn-lg" type="submit">Log in</button>
                                        </div>
                                    </form>

                                    <p class="mt-4 mb-0 text-secondary text-center">
                                        Don't have an account? <a href="/signup" class="text-decoration-none">Sign
                                            up</a>
                                    </p>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
</body>

</html>